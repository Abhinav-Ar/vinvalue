# ---- Database (Postgres). Neon free tier recommended; use the POOLED connection string.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# ---- Auth.js (Google sign-in)
# Generate with: npx auth secret
AUTH_SECRET=
# Google Cloud Console > APIs & Services > Credentials > OAuth client (Web).
# Redirect URI: https://<your-domain>/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ---- Market data (MarketCheck). Without it, appraisals return 503 not_configured.
MARKETCHECK_API_KEY=
# Photo lookup and image proxy use this key server-side only; never expose it in browser DTOs.

# ---- Valuation overrides (optional)
# VALUATION_RADIUS_MILES=100
# VALUATION_MIN_COMPS=8

# ---- Cron: Vercel sends "Authorization: Bearer $CRON_SECRET" to cron routes.
CRON_SECRET=

# ---- File storage (Vercel Blob) for receipts and documents.
BLOB_READ_WRITE_TOKEN=

# ---- Email (Resend). Leave empty in dev: emails are logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM="AutoIQ <alerts@your-domain.com>"

# ---- Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@your-domain.com

# ---- SMS (Twilio). Leave empty in dev: codes/messages are logged (redacted) instead of sent.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---- Public base URL used in alert links and share links.
APP_URL=http://localhost:3000

# ---- Dev only: set to 1 to disable rate limiting locally.
# RATE_LIMIT_DISABLED=1

# ---- Local development only (ignored in production)
# PROVIDERS=fixtures            # use tests/fixtures instead of NHTSA/MarketCheck
# DEV_USER_EMAIL=demo@autoiq.test  # act as this seeded user without Google sign-in (next dev only)
# DATABASE_URL=pglite:./.data/pglite  # embedded Postgres in a folder, no server (dev only)
