{
  "manifest_version": 3,
  "name": "AutoIQ \u2014 Car Form Filler",
  "version": "2.0.0",
  "description": "Use saved AutoIQ vehicle details to complete supported valuation forms faster.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://autoiq-vinvalue.vercel.app/*",
    "https://www.carvana.com/*",
    "https://www.carmax.com/*",
    "https://www.cargurus.com/*",
    "https://www.kbb.com/*",
    "https://www.peddle.com/*",
    "https://www.autonation.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://autoiq-vinvalue.vercel.app/*"
      ],
      "js": [
        "controllers/garageSyncController.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.carvana.com/*",
        "https://www.carmax.com/*",
        "https://www.cargurus.com/*",
        "https://www.kbb.com/*",
        "https://www.peddle.com/*",
        "https://www.autonation.com/*"
      ],
      "js": [
        "controllers/formFillController.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "views/popup.html",
    "default_title": "AutoIQ"
  }
}
