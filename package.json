{
  "name": "autoiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "tsx scripts/seed.ts",
    "fixtures:record": "tsx scripts/record-fixtures.ts",
    "db:migrate:local": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed:local": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.3",
    "@vercel/blob": "^2.9.0",
    "drizzle-orm": "^0.45.4",
    "next": "^15.5.29",
    "next-auth": "^5.0.0-beta.32",
    "postgres": "^4.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
